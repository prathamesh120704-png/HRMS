# Copy to .env.local and fill in. Never commit real values.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (server-only: the browser never talks to Supabase, so no NEXT_PUBLIC_ prefix)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Seed script, cron and email logging only.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Brevo SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Public address of the app, used in email links (defaults to the Vercel URL)
APP_URL=

# AI model (Gemini free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, comma-separated, tried in order (each model has its own small free daily quota). Default: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview. (gemini-2.5-flash is retired for new keys; gemini-3.8-flash hung in testing.) Try gemini-3.5-flash-lite if you hit the free quota
AI_MODEL=

# Protects /api/cron/* routes
CRON_SECRET=

# Use the app's own sign-in page (not Clerk's hosted page)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
